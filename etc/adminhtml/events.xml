<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Refresh the feed on every admin page load (same approach as Magento_AdminNotification). -->
    <event name="controller_action_predispatch">
        <observer name="magepow_notification" instance="Magepow\Core\Observer\CheckNotification" />
    </event>
</config>
