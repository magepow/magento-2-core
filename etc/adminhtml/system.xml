<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="magepow" translate="label" sortOrder="102">
            <label>Magepow</label>
        </tab>
        <section id="magepow_core" translate="label" type="text" sortOrder="0" showInDefault="1" showInWebsite="1" showInStore="1">
            <class>separator-top</class>
            <label>Community</label>
            <tab>magepow</tab>
            <resource>Magepow_Core::config</resource>
            <group id="notification" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                <label>Admin Notifications</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Enable Notifications</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="fetch" translate="label" type="button" sortOrder="35" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Fetch Now</label>
                    <frontend_model>Magepow\Core\Block\Adminhtml\System\Config\FetchButton</frontend_model>
                </field>
                <field id="receive_update" translate="label comment" type="select" sortOrder="36" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Receive Product Updates</label>
                    <comment>When disabled, update items are excluded from the fetched feed.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>magepow_core/notification/receive_update</config_path>
                </field>
                <field id="receive_security" translate="label" type="select" sortOrder="37" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Receive Security Notices</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>magepow_core/notification/receive_security</config_path>
                </field>
                <field id="receive_news" translate="label" type="select" sortOrder="38" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Receive News</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>magepow_core/notification/receive_news</config_path>
                </field>
                <field id="receive_offer" translate="label" type="select" sortOrder="39" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Receive Special Offers</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>magepow_core/notification/receive_offer</config_path>
                </field>
                <field id="receive_general" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Receive General Notices</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>magepow_core/notification/receive_general</config_path>
                </field>
                <field id="update_enabled" translate="label" type="select" sortOrder="40" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Update Notice - Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>magepow_core/notification/update_enabled</config_path>
                </field>
                <field id="security_enabled" translate="label" type="select" sortOrder="50" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Security - Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>magepow_core/notification/security_enabled</config_path>
                </field>
                <field id="promotion_enabled" translate="label" type="select" sortOrder="60" showInDefault="1" showInWebsite="0" showInStore="0">
                    <label>Promotion - Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <config_path>magepow_core/notification/promotion_enabled</config_path>
                </field>
            </group>
        </section>
    </system>
</config>
