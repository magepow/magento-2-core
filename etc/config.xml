<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
	<default>
	    <magepow_core>
            <general>
                <enabled>1</enabled>
            </general>
            <notification>
                <enabled>1</enabled>
                <feed_url>magepow.com/community/notifications/feed/</feed_url>
                <frequency>48</frequency>
                <last_update>0</last_update>
                <receive_update>1</receive_update>
                <receive_security>1</receive_security>
                <receive_news>1</receive_news>
                <receive_offer>1</receive_offer>
                <receive_general>1</receive_general>
                <update_enabled>1</update_enabled>
                <security_enabled>1</security_enabled>
                <promotion_enabled>1</promotion_enabled>
                <update_severity>2</update_severity>
                <update_latest_version>1.2.0</update_latest_version>
                <security_severity>1</security_severity>
                <security_message>A security update is available for Magepow extensions. Please update immediately to protect your store.</security_message>
                <security_url>https://magepow.com/security.html</security_url>
                <promotion_severity>4</promotion_severity>
                <promotion_message>Discover new Magepow extensions with special offers for your store.</promotion_message>
                <promotion_url>https://magepow.com/magento-2-extensions.html</promotion_url>
                <promotion_from_date></promotion_from_date>
                <promotion_to_date></promotion_to_date>
            </notification>
        </magepow_core>    
	</default>
</config>
